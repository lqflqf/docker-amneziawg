#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# shellcheck disable=SC2016,SC1091,SC2183

# Everything this script writes under /config (keys, confs, QR pngs, the saved
# AWG params including HeaderProtectionKey) is secret, so nothing it creates may
# be group or world readable. harden_permissions fixes files from older images.
umask 077

mkdir -p /config/wg_confs

# migration to subfolder for wg confs
if [[ -z "$(ls -A /config/wg_confs)" ]]; then
    if [[ -f /config/awg0.conf ]]; then
        echo "**** Migrating legacy config /config/awg0.conf -> /config/wg_confs/wg0.conf ****"
        cp /config/awg0.conf /config/wg_confs/wg0.conf
        rm -rf /config/awg0.conf || :
    elif [[ -f /config/wg0.conf ]]; then
        echo "**** Migrating legacy config /config/wg0.conf -> /config/wg_confs/wg0.conf ****"
        cp /config/wg0.conf /config/wg_confs/wg0.conf
        rm -rf /config/wg0.conf || :
    fi
fi

# prepare templates
if [[ ! -f /config/templates/server.conf ]]; then
    cp /defaults/server.conf /config/templates/server.conf
fi
if [[ ! -f /config/templates/peer.conf ]]; then
    cp /defaults/peer.conf /config/templates/peer.conf
fi
# add preshared key to user templates (backwards compatibility)
if ! grep -q 'PresharedKey' /config/templates/peer.conf; then
    sed -i 's|^Endpoint|PresharedKey = \$\(cat /config/\${PEER_ID}/presharedkey-\${PEER_ID}\)\nEndpoint|' /config/templates/peer.conf
fi

# ============================================================================
# AWG obfuscation parameter helpers
# ============================================================================

# AWG_VERSION controls the protocol feature set:
#   "2.0" (default) - Full AWG 2.0: S3/S4 padding, H1-H4 range support,
#                     I1-I5 Custom Protocol Signatures (auto-generated if not set)
#   "3.0"           - AWG 2.0 plus HeaderProtectionKey, ContentPaddingAddition
#                     and randomized protocol timers. Requires 3.0-capable
#                     clients; HeaderProtectionKey must match on all ends.
#   "3.1"           - AWG 3.0 plus RandomTrailers. Upstream 3.1 is not a new
#                     parameter set but two independent [Interface] switches;
#                     this preset turns RandomTrailers on and leaves
#                     DisableCookies off. Both are also settable on their own
#                     via AWG_RANDOM_TRAILERS / AWG_DISABLE_COOKIES with any
#                     AWG_VERSION. Requires 3.1-capable software on every end
#                     that uses them.
#   "1.5"           - Legacy mode: S3=S4=0, no I1-I5 signatures,
#                     compatible with AmneziaVPN < 4.8.12.9
# Left empty on purpose: load_awg_params restores the saved version first, so
# recreating a container without AWG_VERSION keeps the deployment on the
# version its peer confs were built for. The 2.0 default is applied in
# generate_awg_params, after that restore. Defaulting here would make the
# awg_params fallback dead code and silently rewrite every peer conf as 2.0.
AWG_VERSION=${AWG_VERSION:-}

# Every AWG parameter saved to /config/server/awg_params.
AWG_PARAM_NAMES=(
    AWG_VERSION AWG_JC AWG_JMIN AWG_JMAX
    AWG_S1 AWG_S2 AWG_S3 AWG_S4 AWG_H1 AWG_H2 AWG_H3 AWG_H4
    AWG_I1 AWG_I2 AWG_I3 AWG_I4 AWG_I5
    AWG_HEADER_PROTECTION_KEY AWG_CONTENT_PADDING AWG_REKEY_AFTER_TIME
    AWG_REKEY_TIMEOUT AWG_REJECT_AFTER_TIME AWG_KEEPALIVE_TIMEOUT
    AWG_MAX_HANDSHAKE_ATTEMPTS AWG_RANDOM_TRAILERS AWG_DISABLE_COOKIES
)
# The parameters whose shape depends on AWG_VERSION (S3/S4 zero in 1.5, the S
# floor of 12 in 3.x, H ranges vs integers, I1-I5, the 3.x set). Saved values of
# these are dropped when the version changes, so a switch actually produces the
# requested protocol. Jc/Jmin/Jmax and the 3.1 switches are version-independent.
AWG_VERSIONED_PARAMS=(
    AWG_S1 AWG_S2 AWG_S3 AWG_S4 AWG_H1 AWG_H2 AWG_H3 AWG_H4
    AWG_I1 AWG_I2 AWG_I3 AWG_I4 AWG_I5
    AWG_HEADER_PROTECTION_KEY AWG_CONTENT_PADDING AWG_REKEY_AFTER_TIME
    AWG_REKEY_TIMEOUT AWG_REJECT_AFTER_TIME AWG_KEEPALIVE_TIMEOUT
    AWG_MAX_HANDSHAKE_ATTEMPTS
)
# Filled by load_awg_params: which parameters came from the environment (those
# are never dropped or regenerated) and the version the saved set was built for.
declare -A AWG_FROM_ENV=()
SAVED_AWG_VERSION=""
# Set by generate_awg_params when a value the user pinned makes the config
# unloadable; generation is then refused and the previous configs stay.
AWG_PARAMS_INVALID=""

# True when the version carries the AWG 3.x parameter set (header protection,
# content padding, randomized timers).
awg_has_3x_params() {
    [[ "${AWG_VERSION}" == "3.0" || "${AWG_VERSION}" == "3.1" ]]
}

# True when the version carries the AWG 2.0+ feature set (H1-H4 ranges,
# I1-I5 signatures). 3.x builds on 2.0, so it is included.
awg_has_2x_features() {
    [[ "${AWG_VERSION}" == "2.0" ]] || awg_has_3x_params
}

# Generate a random hex string of N bytes (2*N hex chars)
random_hex() {
    local nbytes=$1
    head -c "$nbytes" /dev/urandom | od -An -tx1 | tr -d ' \n'
}

# Normalize an AWG 3.1 on/off switch. Empty stays empty, meaning the key is
# not written at all. An unrecognized value is dropped with a warning rather
# than passed through: awg setconf rejects the entire config on a bad value,
# which would take the tunnel down instead of degrading one option.
normalize_awg_switch() {
    local name=$1 value=$2
    case "${value,,}" in
        "")         printf '' ;;
        on|off)     printf '%s' "${value,,}" ;;
        true|1|yes) printf 'on' ;;
        false|0|no) printf 'off' ;;
        *)
            echo "**** WARNING: ${name}=${value} is not a valid on/off value - ignoring ****" >&2
            printf '' ;;
    esac
}

# Generate default I1 signature for AWG 2.0
# Uses QUIC Initial (RFC 9000) — the same default as the Amnezia app itself.
# QUIC is UDP-native, globally neutral, and the most DPI-resistant option:
# the 1200B minimum (RFC 9000 §14.1) matches real Chrome/Firefox traffic.
# Each connection, <r N> tags produce fresh random bytes so every handshake
# looks unique even though the spec string is fixed.
# For custom protocols (DNS, DTLS, SIP, HTTP/3) use https://architect.vai-rice.space/
generate_default_signatures() {
    # QUIC Initial: Long Header 0xC3 (Initial, 4B pkt_num) | QUIC v1 | 8B random DCID
    # no SCID | no token | length varint 0x449E (=1182) | 4B pkt_num | 1178B random payload
    AWG_I1=${AWG_I1:-"<b 0xc3><b 0x00000001><b 0x08><r 8><b 0x00><b 0x00><b 0x449e><r 4><r 1178>"}
    # I2-I5 are optional; leave empty unless explicitly set
    AWG_I2=${AWG_I2:-}
    AWG_I3=${AWG_I3:-}
    AWG_I4=${AWG_I4:-}
    AWG_I5=${AWG_I5:-}
}

# Extract lower/upper bound of an "lo-hi" range (single value => lo=hi)
range_lo() { echo "${1%%-*}"; }
range_hi() { echo "${1##*-}"; }

# AWG 3.0: header protection key, content padding, randomized timers.
# Ranges follow AmneziaWG-Architect "medium" intensity. Timer semantics:
# amneziawg-go device/timers.go — each side uses its own values.
generate_awg3_params() {
    # Shared symmetric key — must be identical on server and all clients.
    # Use genpsk (full-entropy 32 random bytes, like PresharedKey), NOT genkey
    # (genkey emits a bit-clamped Curve25519 private key — wrong generator for
    # a symmetric ChaCha20 header-protection key).
    AWG_HEADER_PROTECTION_KEY=${AWG_HEADER_PROTECTION_KEY:-$(awg genpsk)}

    # Extra random padding on each transport packet.
    #
    # Left at 0 when RandomTrailers is on, because the two are mutually exclusive
    # in a way that only hurts: content padding takes precedence on the *send*
    # path and suppresses the trailers entirely, while the *receive* path reads
    # the trailers flag directly and still relaxes its packet-type matching. You
    # get the risk of trailers and none of their obfuscation. Content padding
    # also costs ~22% of download throughput on its own, because a different
    # length on every datagram defeats UDP_GRO batching on userspace clients.
    # An explicit AWG_CONTENT_PADDING still wins — this only sets the default.
    # See docs/awg-performance.md.
    if [[ -z "${AWG_CONTENT_PADDING}" ]]; then
        if [[ "${AWG_RANDOM_TRAILERS}" == "on" ]]; then
            AWG_CONTENT_PADDING="0"
        else
            local _lo
            _lo=$(shuf -i 16-72 -n 1)
            AWG_CONTENT_PADDING="${_lo}-$(shuf -i $((_lo + 8))-128 -n 1)"
        fi
    fi
    if [[ -z "${AWG_REKEY_TIMEOUT}" ]]; then
        local _lo
        _lo=$(shuf -i 4-6 -n 1)
        AWG_REKEY_TIMEOUT="${_lo}-$((_lo + $(shuf -i 1-4 -n 1)))"
    fi
    if [[ -z "${AWG_KEEPALIVE_TIMEOUT}" ]]; then
        local _lo
        _lo=$(shuf -i 8-14 -n 1)
        AWG_KEEPALIVE_TIMEOUT="${_lo}-$((_lo + $(shuf -i 2-8 -n 1)))"
    fi
    if [[ -z "${AWG_REKEY_AFTER_TIME}" ]]; then
        local _lo
        _lo=$(shuf -i 100-120 -n 1)
        AWG_REKEY_AFTER_TIME="${_lo}-$((_lo + $(shuf -i 10-25 -n 1)))"
    fi
    if [[ -z "${AWG_REJECT_AFTER_TIME}" ]]; then
        # Must satisfy RejectAfterTime.lo > RekeyAfterTime.hi and
        # RejectAfterTime.lo > KeepaliveTimeout.lo + RekeyTimeout.lo
        local _floor=$(( $(range_hi "${AWG_REKEY_AFTER_TIME}") + $(range_hi "${AWG_KEEPALIVE_TIMEOUT}") + $(range_hi "${AWG_REKEY_TIMEOUT}") + 15 ))
        local _lo=$(( _floor > 170 ? _floor : 170 ))
        AWG_REJECT_AFTER_TIME="${_lo}-$((_lo + $(shuf -i 10-25 -n 1)))"
    fi
    if [[ -z "${AWG_MAX_HANDSHAKE_ATTEMPTS}" ]]; then
        local _lo
        _lo=$(shuf -i 12-18 -n 1)
        AWG_MAX_HANDSHAKE_ATTEMPTS="${_lo}-$((_lo + $(shuf -i 2-10 -n 1)))"
    fi
}

# Generate random AWG obfuscation parameters if not set
generate_awg_params() {
    # Applied here rather than at the top of the script so load_awg_params gets
    # a chance to restore a previously saved version first.
    AWG_VERSION=${AWG_VERSION:-2.0}
    echo "**** AmneziaWG version: ${AWG_VERSION} ****"

    # A saved set built for another version has the wrong shape for this one
    # (2.0 H ranges under 1.5, S values below the 3.x floor, ...). Drop the
    # saved version-shaped values so they are drawn for the new version; values
    # pinned in the environment are kept.
    if [[ -n "${SAVED_AWG_VERSION}" ]] && [[ "${SAVED_AWG_VERSION}" != "${AWG_VERSION}" ]]; then
        echo "**** AWG_VERSION changed from ${SAVED_AWG_VERSION} to ${AWG_VERSION}: regenerating the version-specific parameters. Every peer needs its new conf. ****"
        drop_saved_awg_params "${AWG_VERSIONED_PARAMS[@]}"
    fi

    # AWG 3.1 interface switches. Upstream treats these as independent of the
    # parameter set, so they are honoured with any AWG_VERSION; AWG_VERSION=3.1
    # is simply a preset that turns RandomTrailers on. DisableCookies stays
    # opt-in — it gives up WireGuard's built-in DoS mitigation and, unlike
    # RandomTrailers, does not have to match between ends.
    # Normalize what was actually asked for, then let the 3.1 preset fill in a
    # default. Only the explicit value is persisted below: a RandomTrailers
    # that came from AWG_VERSION=3.1 must not outlive a downgrade to 2.0, or a
    # user dropping back to fix an old client would still emit a key that
    # client cannot parse.
    # Resolved here, ahead of the S values, because RandomTrailers constrains
    # how S1-S4 may be drawn (see below).
    local _s_all _s_name
    AWG_RT_EXPLICIT=$(normalize_awg_switch AWG_RANDOM_TRAILERS "${AWG_RANDOM_TRAILERS:-}")
    AWG_DC_EXPLICIT=$(normalize_awg_switch AWG_DISABLE_COOKIES "${AWG_DISABLE_COOKIES:-}")
    AWG_RANDOM_TRAILERS="${AWG_RT_EXPLICIT}"
    AWG_DISABLE_COOKIES="${AWG_DC_EXPLICIT}"
    # "off" is a real value here, not an absence, so it survives s6 and beats
    # both the saved value and this preset.
    if [[ "${AWG_VERSION}" == "3.1" ]]; then
        AWG_RANDOM_TRAILERS=${AWG_RANDOM_TRAILERS:-on}
    fi

    # Core parameters (all versions)
    AWG_JC=${AWG_JC:-$(shuf -i 3-8 -n 1)}
    AWG_JMIN=${AWG_JMIN:-$(shuf -i 40-80 -n 1)}
    AWG_JMAX=${AWG_JMAX:-$(shuf -i 80-250 -n 1)}

    # RandomTrailers relaxes the receiver's packet-type check from an exact
    # length match to a lower bound, which leaves the H ranges as the only thing
    # separating message types — and each type's check reads the type field at
    # *its own* S offset. With unequal S values three of the four checks read the
    # wrong offset and land inside a ~50M-wide H range about 1.16% of the time
    # each, so ~3.5% of transport packets are dropped as malformed handshakes and
    # upload collapses (~100 -> ~2 Mbit/s) while download barely moves. Equal
    # values make every check read the true type field, which the non-overlapping
    # H ranges then reject cleanly. See docs/awg-performance.md.
    # AWG 1.5 is exempt: its single-integer H values are 1 wide, not 50M, so a
    # wrong-offset read matches with probability 2^-32.
    if [[ "${AWG_RANDOM_TRAILERS}" == "on" ]] && awg_has_2x_features; then
        # Saved S values drawn before trailers were turned on are usually
        # unequal; drop those (not pinned ones) so they are redrawn equal.
        if [[ "$AWG_S1" != "$AWG_S2" || "$AWG_S2" != "$AWG_S3" || "$AWG_S3" != "$AWG_S4" ]]; then
            drop_saved_awg_params AWG_S1 AWG_S2 AWG_S3 AWG_S4
        fi
        # 12 satisfies the HeaderProtection floor; <= 20 keeps a full-size packet
        # inside 1500 at awg-quick's derived 1420 MTU (overhead is 60 + S4).
        # A pinned S value is reused for the others, so pinning one is enough.
        _s_all=$(shuf -i 12-20 -n 1)
        for _s_name in AWG_S1 AWG_S2 AWG_S3 AWG_S4; do
            if [[ -n "${!_s_name}" ]]; then
                _s_all=${!_s_name}
                break
            fi
        done
        AWG_S1=${AWG_S1:-$_s_all}
        AWG_S2=${AWG_S2:-$_s_all}
        AWG_S3=${AWG_S3:-$_s_all}
        AWG_S4=${AWG_S4:-$_s_all}
        if [[ "$AWG_S1" != "$AWG_S2" || "$AWG_S2" != "$AWG_S3" || "$AWG_S3" != "$AWG_S4" ]]; then
            echo "**** WARNING: RandomTrailers is on but S1-S4 are not all equal ****"
            echo "**** (S1=$AWG_S1 S2=$AWG_S2 S3=$AWG_S3 S4=$AWG_S4). Around 3.5% of transport ****"
            echo "**** packets will be dropped and upload will collapse. Set AWG_S1, ****"
            echo "**** AWG_S2, AWG_S3 and AWG_S4 to the same value, or turn off      ****"
            echo "**** AWG_RANDOM_TRAILERS. See docs/awg-performance.md.             ****"
        fi
    else
        AWG_S1=${AWG_S1:-$(shuf -i 15-150 -n 1)}
        AWG_S2=${AWG_S2:-$(shuf -i 15-150 -n 1)}
    fi

    if awg_has_2x_features; then
        # AWG 2.0/3.x: H1-H4 as non-overlapping range pairs (quadrant strategy, ~50M width each).
        # Range format (e.g. "90666522-140666522") is required for the Amnezia app to detect AWG 2.0+.
        _h1_lo=$(shuf -i 5-486870911 -n 1);          AWG_H1=${AWG_H1:-${_h1_lo}-$((_h1_lo + 50000000))}
        _h2_lo=$(shuf -i 536870912-1023741823 -n 1);  AWG_H2=${AWG_H2:-${_h2_lo}-$((_h2_lo + 50000000))}
        _h3_lo=$(shuf -i 1073741824-1560612735 -n 1); AWG_H3=${AWG_H3:-${_h3_lo}-$((_h3_lo + 50000000))}
        _h4_lo=$(shuf -i 1610612736-2097483647 -n 1); AWG_H4=${AWG_H4:-${_h4_lo}-$((_h4_lo + 50000000))}
        # S4 is capped at 20 rather than the protocol maximum of 32 because it is
        # paid on every transport packet, in bandwidth and in MTU headroom:
        # overhead is 60 + S4 over IPv4, and awg-quick derives a 1420 tunnel MTU
        # without accounting for S4 at all. Above 20, every full-size packet
        # exceeds 1500 and fragments, which many mobile networks and CGNATs drop
        # outright — "connects fine, downloads crawl". S3 is unconstrained here
        # since cookie replies are rare. See docs/awg-performance.md.
        if awg_has_3x_params; then
            # AWG 3.x: S1-S4 must all be >= 12 — the HeaderProtection nonce is read
            # from the first 12 bytes of the S-padding (amneziawg-go rejects the
            # config otherwise).
            AWG_S3=${AWG_S3:-$(shuf -i 12-55 -n 1)}
            AWG_S4=${AWG_S4:-$(shuf -i 12-20 -n 1)}
        else
            # AWG 2.0: S3/S4 padding
            AWG_S3=${AWG_S3:-$(shuf -i 8-55 -n 1)}
            AWG_S4=${AWG_S4:-$(shuf -i 4-20 -n 1)}
        fi
        generate_default_signatures
    else
        # AWG 1.5 fallback: single integer H values, no S3/S4 padding, no signatures
        AWG_H1=${AWG_H1:-$(shuf -i 5-2147483647 -n 1)}
        AWG_H2=${AWG_H2:-$(shuf -i 5-2147483647 -n 1)}
        AWG_H3=${AWG_H3:-$(shuf -i 5-2147483647 -n 1)}
        AWG_H4=${AWG_H4:-$(shuf -i 5-2147483647 -n 1)}
        AWG_S3=${AWG_S3:-0}
        AWG_S4=${AWG_S4:-0}
        AWG_I1=${AWG_I1:-}
        AWG_I2=${AWG_I2:-}
        AWG_I3=${AWG_I3:-}
        AWG_I4=${AWG_I4:-}
        AWG_I5=${AWG_I5:-}
    fi

    if awg_has_3x_params; then
        generate_awg3_params
    else
        # Not 3.x: keep 3.x params empty (e.g. after switching versions down)
        AWG_HEADER_PROTECTION_KEY=""
        AWG_CONTENT_PADDING=""
        AWG_REKEY_AFTER_TIME=""
        AWG_REKEY_TIMEOUT=""
        AWG_REJECT_AFTER_TIME=""
        AWG_KEEPALIVE_TIMEOUT=""
        AWG_MAX_HANDSHAKE_ATTEMPTS=""
    fi

    # Only reachable when the user pinned AWG_CONTENT_PADDING themselves — the
    # default above already stands down for RandomTrailers.
    if [[ "${AWG_RANDOM_TRAILERS}" == "on" ]] && [[ -n "${AWG_CONTENT_PADDING}" ]] &&
       [[ "${AWG_CONTENT_PADDING}" != "0" && "${AWG_CONTENT_PADDING}" != "0-0" ]]; then
        echo "**** WARNING: ContentPaddingAddition=${AWG_CONTENT_PADDING} is set together with  ****"
        echo "**** RandomTrailers=on. Content padding wins on the send path and suppresses ****"
        echo "**** the trailers, but the receiver still relaxes its packet-type matching — ****"
        echo "**** the risk of trailers with none of the obfuscation, plus roughly 22% of   ****"
        echo "**** download throughput. Set AWG_CONTENT_PADDING=0 to fix.                  ****"
    fi

    echo "**** AWG Obfuscation Parameters ****"
    echo "  Jc=$AWG_JC, Jmin=$AWG_JMIN, Jmax=$AWG_JMAX"
    echo "  S1=$AWG_S1, S2=$AWG_S2, S3=$AWG_S3, S4=$AWG_S4"
    echo "  H1=$AWG_H1, H2=$AWG_H2, H3=$AWG_H3, H4=$AWG_H4"
    if [[ -n "$AWG_I1" ]]; then
        echo "  I1-I5 Custom Protocol Signatures: enabled"
    else
        echo "  I1-I5 Custom Protocol Signatures: disabled (AWG 1.5 mode)"
    fi
    if awg_has_3x_params; then
        echo "  HeaderProtectionKey: set"
        echo "  ContentPaddingAddition=$AWG_CONTENT_PADDING"
        echo "  RekeyAfterTime=$AWG_REKEY_AFTER_TIME, RekeyTimeout=$AWG_REKEY_TIMEOUT"
        echo "  RejectAfterTime=$AWG_REJECT_AFTER_TIME, KeepaliveTimeout=$AWG_KEEPALIVE_TIMEOUT"
        echo "  MaxHandshakeAttempts=$AWG_MAX_HANDSHAKE_ATTEMPTS"
    fi
    if [[ -n "$AWG_RANDOM_TRAILERS" ]] || [[ -n "$AWG_DISABLE_COOKIES" ]]; then
        echo "  AWG 3.1 options: RandomTrailers=${AWG_RANDOM_TRAILERS:-unset}, DisableCookies=${AWG_DISABLE_COOKIES:-unset}"
    fi

    # Validation warnings
    if [[ "$AWG_JMIN" -gt "$AWG_JMAX" ]] 2>/dev/null; then
        echo "**** WARNING: Jmin ($AWG_JMIN) > Jmax ($AWG_JMAX) - junk packets may not work correctly ****"
    fi
    local s1_plus_56=$((AWG_S1 + 56))
    if [[ "$s1_plus_56" -eq "$AWG_S2" ]] 2>/dev/null; then
        echo "**** WARNING: S1+56 ($s1_plus_56) equals S2 ($AWG_S2) - this should be avoided ****"
    fi
    # Check H1-H4 uniqueness (only for fixed values, not ranges)
    if [[ "$AWG_H1" != *-* ]] && [[ "$AWG_H2" != *-* ]] && [[ "$AWG_H3" != *-* ]] && [[ "$AWG_H4" != *-* ]]; then
        local -A h_values
        for h_name in AWG_H1 AWG_H2 AWG_H3 AWG_H4; do
            local h_val="${!h_name}"
            if [[ -n "${h_values[$h_val]+x}" ]]; then
                echo "**** WARNING: $h_name has duplicate value $h_val (same as ${h_values[$h_val]}) - H1-H4 should be unique ****"
            fi
            h_values[$h_val]="$h_name"
        done
    fi

    # AWG 3.x validation warnings
    if awg_has_3x_params; then
        # S1-S4 >= 12 is a hard requirement of HeaderProtectionKey
        if [[ -n "${AWG_HEADER_PROTECTION_KEY}" ]]; then
            for _s_name in AWG_S1 AWG_S2 AWG_S3 AWG_S4; do
                if (( ${!_s_name} < 12 )) 2>/dev/null; then
                    echo "**** ERROR: ${_s_name} (${!_s_name}) < 12 - all S values must be >= 12 when HeaderProtectionKey is set, amneziawg-go would reject the config. Raise it, or unset it to have it generated. ****"
                    AWG_PARAMS_INVALID=1
                fi
            done
        fi
        # Timer invariants (amneziawg-go device/timers.go)
        if (( $(range_lo "${AWG_REJECT_AFTER_TIME}") <= $(range_lo "${AWG_KEEPALIVE_TIMEOUT}") + $(range_lo "${AWG_REKEY_TIMEOUT}") )) 2>/dev/null; then
            echo "**** WARNING: RejectAfterTime lower bound (${AWG_REJECT_AFTER_TIME}) must be greater than KeepaliveTimeout.lo + RekeyTimeout.lo (${AWG_KEEPALIVE_TIMEOUT} + ${AWG_REKEY_TIMEOUT}) ****"
        fi
        if (( $(range_hi "${AWG_REKEY_AFTER_TIME}") >= $(range_lo "${AWG_REJECT_AFTER_TIME}") )) 2>/dev/null; then
            echo "**** WARNING: RekeyAfterTime upper bound (${AWG_REKEY_AFTER_TIME}) must be less than RejectAfterTime lower bound (${AWG_REJECT_AFTER_TIME}) ****"
        fi
        if (( $(range_lo "${AWG_MAX_HANDSHAKE_ATTEMPTS}") < 1 )) 2>/dev/null; then
            echo "**** WARNING: MaxHandshakeAttempts lower bound (${AWG_MAX_HANDSHAKE_ATTEMPTS}) must be >= 1 ****"
        fi
    fi
}

# Load saved AWG params as fallback. Never `source` the file: that would
# override the environment, and it is data, not code. Values set in the
# environment win and are recorded in AWG_FROM_ENV.
load_awg_params() {
    local name value file=/config/server/awg_params
    for name in "${AWG_PARAM_NAMES[@]}"; do
        [[ -n "${!name:-}" ]] && AWG_FROM_ENV[$name]=1
    done
    [[ -f "${file}" ]] || return 0
    SAVED_AWG_VERSION=$(grep -m1 "^AWG_VERSION=" "${file}" | cut -d= -f2-)
    for name in "${AWG_PARAM_NAMES[@]}"; do
        [[ -n "${AWG_FROM_ENV[$name]:-}" ]] && continue
        # cut -f2-: I1-I5 tags contain "=" themselves
        value=$(grep -m1 "^${name}=" "${file}" | cut -d= -f2-)
        printf -v "${name}" '%s' "${value}"
    done
}

# Clear the given parameters unless they were set in the environment, so the
# generators below draw them afresh.
drop_saved_awg_params() {
    local name
    for name in "$@"; do
        [[ -n "${AWG_FROM_ENV[$name]:-}" ]] || printf -v "${name}" '%s' ""
    done
}

# Persist the parameters the current confs were generated with. Called only
# once those confs are in place (or already current), so a failed generation
# never leaves awg_params describing configs that do not exist. Only the
# explicitly set 3.1 switches are saved, see generate_awg_params.
save_awg_params() {
    local name value
    mkdir -p /config/server || return 1
    {
        for name in "${AWG_PARAM_NAMES[@]}"; do
            case "${name}" in
                AWG_RANDOM_TRAILERS) value=${AWG_RT_EXPLICIT} ;;
                AWG_DISABLE_COOKIES) value=${AWG_DC_EXPLICIT} ;;
                *) value=${!name} ;;
            esac
            printf '%s=%s\n' "${name}" "${value//$'\n'/ }"
        done
    } > /config/server/awg_params.tmp && mv -f /config/server/awg_params.tmp /config/server/awg_params
}

# Append I1-I5 to a config file if set (used for server conf, which has no [Peer] section yet)
append_awg_signatures() {
    local conf_file=$1
    [[ -n "$AWG_I1" ]] && echo "I1 = ${AWG_I1}" >> "$conf_file"
    [[ -n "$AWG_I2" ]] && echo "I2 = ${AWG_I2}" >> "$conf_file"
    [[ -n "$AWG_I3" ]] && echo "I3 = ${AWG_I3}" >> "$conf_file"
    [[ -n "$AWG_I4" ]] && echo "I4 = ${AWG_I4}" >> "$conf_file"
    [[ -n "$AWG_I5" ]] && echo "I5 = ${AWG_I5}" >> "$conf_file"
}

# Insert I1-I5 into the [Interface] section of a peer conf, before the [Peer]
# line — the Amnezia app only looks for signature packets in [Interface].
#
# Empty values are skipped rather than written as a bare "I2 =". awg rejects an
# empty value outright ("Line unrecognized: `I2='"), which makes the whole conf
# unloadable by awg-quick, by `awg setconf`, and by this image in client mode —
# so a peer conf carrying placeholders only works in GUI clients with a more
# forgiving parser. Earlier versions wrote them deliberately, on the theory that
# their presence signalled AWG 2.0+ to the Amnezia app; version detection
# actually keys off the H1-H4 range format, which is emitted independently and
# is unaffected by this. The server-side append_awg_signatures() has always
# skipped empties, so this also makes the two sides agree.
append_awg_signatures_to_interface() {
    local conf_file=$1
    local sig_block="" _n _var _v
    for _n in 1 2 3 4 5; do
        _var="AWG_I${_n}"
        _v="${!_var:-}"
        [[ -n "$_v" ]] && sig_block+="I${_n} = ${_v}"$'\n'
    done
    [[ -z "$sig_block" ]] && return 0
    local tmp
    tmp=$(awk -v block="$sig_block" '
        /^\[Peer\]/ && !done { printf "%s", block; done=1 }
        { print }
    ' "$conf_file")
    printf '%s\n' "$tmp" > "$conf_file"
}

# Append AWG 3.0 params to the server conf (called before any [Peer] section exists)
append_awg3_params() {
    local conf_file=$1
    awg_has_3x_params || return 0
    cat >> "$conf_file" <<EOF
HeaderProtectionKey = ${AWG_HEADER_PROTECTION_KEY}
ContentPaddingAddition = ${AWG_CONTENT_PADDING}
RekeyAfterTime = ${AWG_REKEY_AFTER_TIME}
RekeyTimeout = ${AWG_REKEY_TIMEOUT}
RejectAfterTime = ${AWG_REJECT_AFTER_TIME}
KeepaliveTimeout = ${AWG_KEEPALIVE_TIMEOUT}
MaxHandshakeAttempts = ${AWG_MAX_HANDSHAKE_ATTEMPTS}
EOF
}

# Insert AWG 3.0 params into the [Interface] section of a peer conf (before the [Peer] line)
append_awg3_params_to_interface() {
    local conf_file=$1
    awg_has_3x_params || return 0
    local sig_block="HeaderProtectionKey = ${AWG_HEADER_PROTECTION_KEY}"$'\n'
    sig_block+="ContentPaddingAddition = ${AWG_CONTENT_PADDING}"$'\n'
    sig_block+="RekeyAfterTime = ${AWG_REKEY_AFTER_TIME}"$'\n'
    sig_block+="RekeyTimeout = ${AWG_REKEY_TIMEOUT}"$'\n'
    sig_block+="RejectAfterTime = ${AWG_REJECT_AFTER_TIME}"$'\n'
    sig_block+="KeepaliveTimeout = ${AWG_KEEPALIVE_TIMEOUT}"$'\n'
    sig_block+="MaxHandshakeAttempts = ${AWG_MAX_HANDSHAKE_ATTEMPTS}"$'\n'
    local tmp
    tmp=$(awk -v block="$sig_block" '
        /^\[Peer\]/ && !done { printf "%s", block; done=1 }
        { print }
    ' "$conf_file")
    printf '%s\n' "$tmp" > "$conf_file"
}

# Warn when the AWG 3.1 switches are requested against a kernel module that
# predates them. awg setconf rejects the entire config with "Line unrecognized"
# in that case, so the tunnel fails to come up rather than losing one option.
# The bundled userspace amneziawg-go is a 3.1 build and always supports them.
check_awg31_kernel_support() {
    [[ "${AWG_RANDOM_TRAILERS}" == "on" || "${AWG_DISABLE_COOKIES}" == "on" ]] || return 0
    [[ -n "${WG_QUICK_USERSPACE_IMPLEMENTATION:-}" ]] && return 0
    [[ -r /sys/module/amneziawg/version ]] || return 0
    local modver major minor
    modver=$(cat /sys/module/amneziawg/version)
    major=${modver%%.*}
    minor=${modver#*.}; minor=${minor%%.*}
    # Stay silent on anything we cannot read as a number ("v3.1.0", a
    # git-describe string, a distro suffix). In bash arithmetic a non-numeric
    # word is resolved as a variable name and evaluates to 0, which would make
    # a perfectly capable module look ancient and fire a false warning.
    [[ "${major}" =~ ^[0-9]+$ && "${minor}" =~ ^[0-9]+$ ]] || return 0
    if (( major < 3 || (major == 3 && minor < 1) )); then
        echo "**** WARNING: RandomTrailers/DisableCookies need amneziawg kernel module 3.1 or newer, but ${modver} is loaded ****"
        echo "****          The bundled awg parses these keys, so the failure comes from the kernel: awg-quick reports      ****"
        echo "****          \"Unable to modify interface: Invalid argument\" and the tunnel does not come up.                ****"
        echo "****          Upgrade the host module (amneziawg-dkms), or set AWG_RANDOM_TRAILERS=off and                   ****"
        echo "****          AWG_DISABLE_COOKIES=off, which omits the keys entirely.                                         ****"
    fi
}

# Build the AWG 3.1 [Interface] switch block into the caller's BLOCK_OUT
# variable, or leave it empty if neither switch is set. These are independent
# of AWG_VERSION, so unlike the 3.x parameter block they are written for any
# version the user pairs them with.
#
# The block is returned via a variable rather than stdout on purpose: command
# substitution strips trailing newlines, which would glue the last option onto
# the following [Peer] line and make awg setconf reject the whole config.
# Only "on" emits a key. "off" is deliberately written as an absent key rather
# than "= off": off is already the endpoint default, so the two are functionally
# identical, and omitting it keeps the config parseable by an older amneziawg
# that does not know the key at all. That makes "off" the way out of a tunnel
# broken by these switches — an empty value cannot serve that role, because s6
# drops empty variables from container_environment and the script would see it
# as absent, i.e. "reuse the saved value".
awg31_options_block() {
    BLOCK_OUT=""
    [[ "${AWG_RANDOM_TRAILERS}" == "on" ]] && BLOCK_OUT+="RandomTrailers = on"$'\n'
    [[ "${AWG_DISABLE_COOKIES}" == "on" ]] && BLOCK_OUT+="DisableCookies = on"$'\n'
}

# Append the AWG 3.1 options to the server conf (called before any [Peer] exists)
append_awg31_options() {
    local conf_file=$1
    local BLOCK_OUT
    awg31_options_block
    [[ -z "${BLOCK_OUT}" ]] && return 0
    printf '%s' "${BLOCK_OUT}" >> "$conf_file"
}

# Insert the AWG 3.1 options into the [Interface] section of a peer conf
# (before the [Peer] line)
append_awg31_options_to_interface() {
    local conf_file=$1
    local BLOCK_OUT
    awg31_options_block
    [[ -z "${BLOCK_OUT}" ]] && return 0
    local tmp
    tmp=$(awk -v block="${BLOCK_OUT}" '
        /^\[Peer\]/ && !done { printf "%s", block; done=1 }
        { print }
    ' "$conf_file")
    printf '%s\n' "$tmp" > "$conf_file"
}

# ============================================================================
# Config generation (matches LinuxServer docker-wireguard pattern)
# ============================================================================

# Regeneration is transactional. Every conf and QR png is rendered into a
# private staging directory and checked, including by awg's own parser; only
# then is the set moved over the live files, and if a move fails the files
# already moved are put back. A broken template, a failed key command or a bad
# value therefore leaves the previous configs in place. The caller saves state
# only on success, so the next start retries. Keys are created in place: they
# are persistent identities, not part of the generated set.
generate_confs () {
    local stage rc
    local -a staged_ids=() staged_labels=()
    local -A PEER_IP=()
    mkdir -p /config/server /config/wg_confs || return 1
    rm -rf /config/.awg-staging.*
    stage=$(mktemp -d /config/.awg-staging.XXXXXX) || return 1
    if render_confs "${stage}" && validate_confs "${stage}" && install_confs "${stage}"; then
        rc=0
        log_peer_confs
        archive_removed_peers
    else
        rc=1
    fi
    rm -rf "${stage}"
    return "${rc}"
}

# Templates are expanded with eval, so shell syntax in them runs as root. That
# is no wider than /config already is (PostUp lines in any conf in wg_confs run
# as root too), which makes /config a trusted, root-equivalent input. Refuse a
# template that anyone on the host can write.
check_template () {
    local file=$1 mode
    mode=$(stat -c %a "${file}") || return 1
    if (( 8#${mode} & 8#002 )); then
        echo "**** ERROR: ${file} is world-writable (mode ${mode}). Templates run as root when configs are generated; run 'chmod o-w ${file}' on the host and restart. ****"
        return 1
    fi
}

# First IPv4 address on the Address line of a conf, without the prefix length.
conf_address () {
    awk -F= '
        /^[[:space:]]*Address[[:space:]]*=/ {
            v = $2; gsub(/[[:space:]]/, "", v); split(v, a, ","); sub(/\/.*/, "", a[1]); print a[1]; exit
        }' "$1"
}

# An existing peer keeps the address in its conf (moved into the new subnet if
# INTERNAL_SUBNET changed); a new peer gets the lowest address no current peer
# holds. Only peers in PEERS count: removed peers are archived once the new set
# is installed, which frees their addresses.
assign_peer_addresses () {
    local id ip idx
    local -A used=()
    for id in "${PEER_IDS[@]}"; do
        ip=""
        if [[ -f "/config/${id}/${id}.conf" ]]; then
            ip=$(conf_address "/config/${id}/${id}.conf")
            if [[ -n "${ORIG_INTERFACE}" ]] && [[ "${INTERFACE}" != "${ORIG_INTERFACE}" ]] && [[ "${ip}" == "${ORIG_INTERFACE}."* ]]; then
                ip="${INTERFACE}.${ip##*.}"
            fi
            if [[ -n "${ip}" ]] && [[ -n "${used[${ip}]:-}" ]]; then
                echo "**** WARNING: ${id} has the same address (${ip}) as another peer, giving it a new one ****"
                ip=""
            fi
        fi
        PEER_IP[${id}]=${ip}
        [[ -n "${ip}" ]] && used[${ip}]=1
    done
    for id in "${PEER_IDS[@]}"; do
        [[ -n "${PEER_IP[${id}]}" ]] && continue
        for idx in {2..254}; do
            if [[ -z "${used[${INTERFACE}.${idx}]:-}" ]]; then
                PEER_IP[${id}]="${INTERFACE}.${idx}"
                used[${INTERFACE}.${idx}]=1
                break
            fi
        done
        if [[ -z "${PEER_IP[${id}]}" ]]; then
            echo "**** ERROR: no address could be found for ${id} in ${INTERFACE}.0/24 ****"
            return 1
        fi
    done
}

render_confs () {
    local stage=$1 n i PEER_ID CLIENT_IP SERVER_ALLOWEDIPS peer_conf
    check_template /config/templates/server.conf || return 1
    check_template /config/templates/peer.conf || return 1
    if [[ ! -s /config/server/privatekey-server ]]; then
        awg genkey | tee /config/server/privatekey-server | awg pubkey > /config/server/publickey-server
    fi
    if [[ ! -s /config/server/privatekey-server ]] || [[ ! -s /config/server/publickey-server ]]; then
        echo "**** ERROR: could not create the server keys in /config/server ****"
        return 1
    fi
    if ! eval "$(printf %s)
    cat <<DUDE > ${stage}/wg0.conf
$(cat /config/templates/server.conf)

DUDE"; then
        echo "**** ERROR: /config/templates/server.conf could not be rendered, see the error above ****"
        return 1
    fi
    # Append I1-I5 signature packets to server conf
    append_awg_signatures "${stage}/wg0.conf"
    # Append AWG 3.x params to server conf (no-op unless AWG_VERSION is 3.0/3.1)
    append_awg3_params "${stage}/wg0.conf"
    # Append AWG 3.1 switches to server conf (no-op unless either is set)
    append_awg31_options "${stage}/wg0.conf"
    assign_peer_addresses || return 1
    for n in "${!PEER_IDS[@]}"; do
        PEER_ID=${PEER_IDS[$n]}
        i=${PEER_LABELS[$n]}
        CLIENT_IP=${PEER_IP[${PEER_ID}]}
        peer_conf="${stage}/${PEER_ID}/${PEER_ID}.conf"
        mkdir -p "/config/${PEER_ID}" "${stage}/${PEER_ID}" || return 1
        if [[ ! -s "/config/${PEER_ID}/privatekey-${PEER_ID}" ]]; then
            awg genkey | tee "/config/${PEER_ID}/privatekey-${PEER_ID}" | awg pubkey > "/config/${PEER_ID}/publickey-${PEER_ID}"
            awg genpsk > "/config/${PEER_ID}/presharedkey-${PEER_ID}"
            if [[ ! -s "/config/${PEER_ID}/publickey-${PEER_ID}" ]] || [[ ! -s "/config/${PEER_ID}/presharedkey-${PEER_ID}" ]]; then
                echo "**** ERROR: could not create the keys for ${PEER_ID} ****"
                return 1
            fi
        fi
        if [[ -f "/config/${PEER_ID}/presharedkey-${PEER_ID}" ]]; then
            # create peer conf with presharedkey
            if ! eval "$(printf %s)
            cat <<DUDE > ${peer_conf}
$(cat /config/templates/peer.conf)
DUDE"; then
                echo "**** ERROR: /config/templates/peer.conf could not be rendered for ${PEER_ID}, see the error above ****"
                return 1
            fi
        else
            echo "**** Existing keys with no preshared key found for ${PEER_ID}, creating confs without preshared key for backwards compatibility ****"
            # create peer conf without presharedkey
            if ! eval "$(printf %s)
            cat <<DUDE > ${peer_conf}
$(sed '/PresharedKey/d' "/config/templates/peer.conf")
DUDE"; then
                echo "**** ERROR: /config/templates/peer.conf could not be rendered for ${PEER_ID}, see the error above ****"
                return 1
            fi
        fi
        # Insert I1-I5 into [Interface] section of peer conf
        append_awg_signatures_to_interface "${peer_conf}"
        # Insert AWG 3.x params into [Interface] section (no-op unless AWG_VERSION is 3.0/3.1)
        append_awg3_params_to_interface "${peer_conf}"
        # Insert AWG 3.1 switches into [Interface] section (no-op unless either is set)
        append_awg31_options_to_interface "${peer_conf}"
        # add peer info to server conf, with presharedkey if the peer has one
        cat <<DUDE >> "${stage}/wg0.conf"
[Peer]
# ${PEER_ID}
PublicKey = $(cat "/config/${PEER_ID}/publickey-${PEER_ID}")
DUDE
        if [[ -f "/config/${PEER_ID}/presharedkey-${PEER_ID}" ]]; then
            cat <<DUDE >> "${stage}/wg0.conf"
PresharedKey = $(cat "/config/${PEER_ID}/presharedkey-${PEER_ID}")
DUDE
        fi
        SERVER_ALLOWEDIPS=SERVER_ALLOWEDIPS_PEER_${i}
        # add peer's allowedips to server conf
        if [[ -n "${!SERVER_ALLOWEDIPS}" ]]; then
            echo "Adding ${!SERVER_ALLOWEDIPS} to wg0.conf's AllowedIPs for peer ${i}"
            cat <<DUDE >> "${stage}/wg0.conf"
AllowedIPs = ${CLIENT_IP}/32,${!SERVER_ALLOWEDIPS}
DUDE
        else
            cat <<DUDE >> "${stage}/wg0.conf"
AllowedIPs = ${CLIENT_IP}/32
DUDE
        fi
        # add PersistentKeepalive if the peer is specified
        if [[ -n "${PERSISTENTKEEPALIVE_PEERS_ARRAY}" ]] && ([[ "${PERSISTENTKEEPALIVE_PEERS_ARRAY[0]}" = "all" ]] || printf '%s\0' "${PERSISTENTKEEPALIVE_PEERS_ARRAY[@]}" | grep -Fxqz -- "${i}"); then
            cat <<DUDE >> "${stage}/wg0.conf"
PersistentKeepalive = 25

DUDE
        else
            cat <<DUDE >> "${stage}/wg0.conf"

DUDE
        fi
        if ! qrencode -o "${stage}/${PEER_ID}/${PEER_ID}.png" < "${peer_conf}"; then
            echo "**** ERROR: could not create the QR code for ${PEER_ID} ****"
            return 1
        fi
        staged_ids+=("${PEER_ID}")
        staged_labels+=("${i}")
    done
}

# Structural checks on one staged conf. They catch what a failed $(...) in a
# template leaves behind (an empty "PrivateKey =" or "PublicKey =") and a
# missing section. Extra [Peer] blocks are allowed, since a custom server
# template may add its own.
validate_conf () {
    local conf=$1 min_peers=$2
    awk -v min="${min_peers}" -v name="${conf##*/}" '
        /^\[Interface\]/ { iface++ }
        /^\[Peer\]/ { peers++ }
        /^PrivateKey *= *[^ ]/ { key++ }
        /^[A-Za-z0-9]+ *= *$/ { printf "**** ERROR: %s: empty value on line %d: %s ****\n", name, NR, $0; bad = 1 }
        END {
            if (iface != 1) { printf "**** ERROR: %s: expected one [Interface] section, found %d ****\n", name, iface; bad = 1 }
            if (key != 1) { printf "**** ERROR: %s: expected one PrivateKey, found %d ****\n", name, key; bad = 1 }
            if (peers < min) { printf "**** ERROR: %s: expected at least %d [Peer] section(s), found %d ****\n", name, min, peers; bad = 1 }
            exit bad
        }' "${conf}"
}

# Parse one staged conf with awg itself, exactly as tunnel start would.
# awg-quick strip drops the keys only awg-quick handles (Address, DNS, PostUp,
# ...); awg setconf then parses the rest and only afterwards tries to apply it,
# to an interface that does not exist, which fails with "Unable to modify
# interface". Any other failure is a parse error (unknown key, bad value,
# duplicate section, ...). Endpoint is replaced first because setconf resolves
# hostnames, and whether SERVERURL resolves right now is not the question.
PARSE_CHECK_IFACE=awgparsecheck
parse_check_conf () {
    local conf=$1 dir out
    if ip link show dev "${PARSE_CHECK_IFACE}" >/dev/null 2>&1; then
        echo "**** WARNING: an interface named ${PARSE_CHECK_IFACE} exists, skipping the awg parse check ****"
        return 0
    fi
    dir=$(mktemp -d /tmp/awgcheck.XXXXXX) || return 1
    cp "${conf}" "${dir}/awgcheck.conf"
    if ! out=$(awg-quick strip "${dir}/awgcheck.conf" 2>&1 > "${dir}/stripped"); then
        echo "**** ERROR: ${conf##*/}: ${out} ****"
        rm -rf "${dir}"
        return 1
    fi
    sed -i 's/^\([[:space:]]*Endpoint[[:space:]]*=\).*/\1 127.0.0.1:51820/' "${dir}/stripped"
    out=$(WG_ENDPOINT_RESOLUTION_RETRIES=0 awg setconf "${PARSE_CHECK_IFACE}" "${dir}/stripped" 2>&1)
    rm -rf "${dir}"
    if [[ "${out}" == *"Unable to modify interface"* ]]; then
        return 0
    fi
    echo "**** ERROR: ${conf##*/} is rejected by awg: ${out//$'\n'/ } ****"
    return 1
}

validate_confs () {
    local stage=$1 id ok=0
    validate_conf "${stage}/wg0.conf" "${#staged_ids[@]}" || ok=1
    parse_check_conf "${stage}/wg0.conf" || ok=1
    for id in "${staged_ids[@]}"; do
        validate_conf "${stage}/${id}/${id}.conf" 1 || ok=1
        parse_check_conf "${stage}/${id}/${id}.conf" || ok=1
    done
    return "${ok}"
}

# Move the staged set over the live files: wg0.conf first, then the peer confs,
# the pngs last, so a png existing means its conf is final (the CI smoke test
# waits on it). Each live file is backed up first; if any move fails, every
# file already moved is restored (or removed, if it did not exist before).
install_confs () {
    local stage=$1 backup=$1/.previous id n src dst
    local -a srcs=() dsts=() moved=()
    mkdir -p "${backup}" || return 1
    srcs+=("${stage}/wg0.conf"); dsts+=(/config/wg_confs/wg0.conf)
    for id in "${staged_ids[@]}"; do
        srcs+=("${stage}/${id}/${id}.conf"); dsts+=("/config/${id}/${id}.conf")
    done
    for id in "${staged_ids[@]}"; do
        srcs+=("${stage}/${id}/${id}.png"); dsts+=("/config/${id}/${id}.png")
    done
    for n in "${!srcs[@]}"; do
        src=${srcs[$n]}
        dst=${dsts[$n]}
        if [[ -e "${dst}" ]] && ! cp -p "${dst}" "${backup}/${n}"; then
            rollback_install "${backup}" "${moved[@]}"
            return 1
        fi
        if ! mv -f "${src}" "${dst}"; then
            echo "**** ERROR: could not install ${dst} ****"
            rollback_install "${backup}" "${moved[@]}"
            return 1
        fi
        moved+=("${n}:${dst}")
    done
}

rollback_install () {
    local backup=$1 entry n dst k
    shift
    echo "**** Restoring the previous configs ****"
    for (( k = $#; k >= 1; k-- )); do
        entry=${!k}
        n=${entry%%:*}
        dst=${entry#*:}
        if [[ -e "${backup}/${n}" ]]; then
            mv -f "${backup}/${n}" "${dst}"
        else
            rm -f "${dst}"
        fi
    done
}

# QR codes carry the peer's private and preshared keys, so they go to the log
# (and from there to wherever logs are shipped) only when asked for.
log_peer_confs () {
    local n id
    for n in "${!staged_ids[@]}"; do
        id=${staged_ids[$n]}
        if [[ "${LOG_CONFS,,}" == "true" ]]; then
            echo "PEER ${staged_labels[$n]} QR code (conf file is saved under /config/${id}):"
            qrencode -t ansiutf8 < "/config/${id}/${id}.conf"
        else
            echo "PEER ${staged_labels[$n]} conf and QR code png saved in /config/${id} (show it with: docker exec <container> /app/show-peer ${staged_labels[$n]})"
        fi
    done
}

# A peer dropped from PEERS is already gone from wg0.conf, so its keys no longer
# work anywhere. Its directory is moved to /config/removed_peers/ rather than
# deleted, which frees its address; adding the name back creates a new identity.
archive_removed_peers () {
    local dir id stamp
    local -A active=()
    for id in "${PEER_IDS[@]}"; do
        active[${id}]=1
    done
    stamp=$(date +%Y%m%d-%H%M%S)
    for dir in /config/peer*/; do
        [[ -d "${dir}" ]] || continue
        dir=${dir%/}
        id=${dir##*/}
        [[ -n "${active[${id}]:-}" ]] && continue
        [[ -f "${dir}/privatekey-${id}" ]] || [[ -f "${dir}/${id}.conf" ]] || continue
        if mkdir -p /config/removed_peers && mv "${dir}" "/config/removed_peers/${id}-${stamp}"; then
            echo "**** ${id} is no longer in PEERS: moved it to /config/removed_peers/${id}-${stamp} ****"
        else
            echo "**** WARNING: could not move ${dir} to /config/removed_peers ****"
        fi
    done
}

config_generation_failed () {
    echo "**** ERROR: Config generation failed. No config file was changed, and the previous configs (if any) will be used. ****"
    echo "****        Fix the error above and restart the container to try again.                                              ****"
}

warn_if_subnet_outside_dns_acl () {
    # The unbound.conf shipped by older images answers 127.0.0.0/8 and the
    # RFC1918 range only. A VPN subnet outside those is refused, so peers on
    # PEERDNS=auto get no DNS at all with nothing in the log to explain it.
    local first second
    first=${1%%.*}
    second=${1#*.}; second=${second%%.*}
    [[ "$first" =~ ^[0-9]+$ ]] || return 0
    [[ "$second" =~ ^[0-9]+$ ]] || return 0
    if [[ "$first" == "10" ]] || [[ "$first" == "127" ]] || \
        { [[ "$first" == "192" ]] && [[ "$second" == "168" ]]; } || \
        { [[ "$first" == "172" ]] && (( second >= 16 && second <= 31 )); }; then
        return 0
    fi
    echo "**** WARNING: The internal subnet ${INTERNAL_SUBNET} is outside the ranges your unbound.conf answers (127.0.0.0/8 and RFC1918), so peers using PEERDNS=auto will be REFUSED. Add \"access-control: ${1}.0/24 allow\" to /config/unbound/unbound.conf, or set PEERDNS to a resolver of your own. ****"
}

# ============================================================================
# Saved state (/config/.donoteditthisfile)
# ============================================================================

STATE_FILE=/config/.donoteditthisfile
# Every input that shapes the generated confs; a change in any regenerates.
STATE_VARS=(
    SERVERURL SERVERPORT PEERDNS PEERS INTERFACE ALLOWEDIPS PERSISTENTKEEPALIVE_PEERS
    "${AWG_PARAM_NAMES[@]}" SERVER_ALLOWEDIPS_ALL TEMPLATES_HASH
)
# Added after the file format existed. Missing from an older file means
# "unknown", which must not force a regeneration on upgrade.
STATE_VARS_OPTIONAL=(SERVER_ALLOWEDIPS_ALL TEMPLATES_HASH)
declare -A ORIG=()

# The state file is data. It used to be sourced, which turned any value in it,
# an auto-detected SERVERURL included, into code run as root on the next start.
load_state () {
    local line name value
    [[ -f "${STATE_FILE}" ]] || return 0
    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ "${line}" =~ ^ORIG_([A-Z0-9_]+)=(.*)$ ]] || continue
        name=${BASH_REMATCH[1]}
        value=${BASH_REMATCH[2]}
        if (( ${#value} >= 2 )) && [[ "${value:0:1}" == '"' ]] && [[ "${value: -1}" == '"' ]]; then
            value=${value:1:${#value}-2}
        fi
        ORIG[${name}]=${value}
    done < "${STATE_FILE}"
}

# Values are stored one per line, so newlines are folded (the same way on both
# sides of the comparison).
state_value () {
    printf '%s' "${1//$'\n'/ }"
}

save_vars () {
    local name
    {
        for name in "${STATE_VARS[@]}"; do
            printf 'ORIG_%s="%s"\n' "${name}" "$(state_value "${!name}")"
        done
    } > "${STATE_FILE}.tmp" && mv -f "${STATE_FILE}.tmp" "${STATE_FILE}"
}

# Sets CHANGED_VAR to the first input that differs from the saved state.
state_changed () {
    local name opt
    CHANGED_VAR=""
    for name in "${STATE_VARS[@]}"; do
        if [[ -z "${ORIG[${name}]+set}" ]]; then
            for opt in "${STATE_VARS_OPTIONAL[@]}"; do
                [[ "${opt}" == "${name}" ]] && continue 2
            done
        fi
        if [[ "$(state_value "${!name}")" != "${ORIG[${name}]:-}" ]]; then
            CHANGED_VAR=${name}
            return 0
        fi
    done
    return 1
}

# All SERVER_ALLOWEDIPS_PEER_<peer> values, in a stable order.
server_allowedips_all () {
    local name out=""
    while IFS= read -r name; do
        [[ -n "${name}" ]] && out+="${name#SERVER_ALLOWEDIPS_PEER_}=${!name};"
    done < <(compgen -v SERVER_ALLOWEDIPS_PEER_ | sort)
    printf '%s' "${out}"
}

# ============================================================================
# Input validation
# ============================================================================

is_ipv4 () {
    local octet='(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])'
    [[ "$1" =~ ^${octet}\.${octet}\.${octet}\.${octet}$ ]]
}

# A valid Endpoint host: a DNS name, an IPv4 address or a bracketed IPv6 address.
valid_endpoint_host () {
    local host=$1 label='[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
    is_ipv4 "${host}" && return 0
    [[ "${host}" =~ ^\[[0-9A-Fa-f:.]+\]$ ]] && return 0
    (( ${#host} <= 253 )) && [[ "${host}" =~ ^(${label}\.)*${label}\.?$ ]]
}

# The server's public IPv4 over HTTPS, from the first service that returns a
# well-formed address. A plain-HTTP answer could be rewritten on the way.
detect_public_ipv4 () {
    local url ip
    for url in https://ipv4.icanhazip.com https://api.ipify.org https://ifconfig.me/ip; do
        ip=$(curl -fsS -4 --max-time 10 "${url}" 2>/dev/null | tr -d '[:space:]')
        if is_ipv4 "${ip}"; then
            printf '%s' "${ip}"
            return 0
        fi
    done
    return 1
}

# ============================================================================
# Unbound
# ============================================================================

# Written at every start and included by the default unbound.conf: listen on
# loopback and, in server mode, the tunnel address only, and answer only those
# networks. ip-freebind lets unbound bind the tunnel address before the tunnel
# exists (svc-unbound starts first).
write_unbound_listen () {
    mkdir -p /run/unbound
    {
        echo "# Generated at every start by init-amneziawg-confs. Do not edit;"
        echo "# add settings to /config/unbound/unbound.conf instead."
        echo "interface: 127.0.0.1"
        echo "access-control: 127.0.0.0/8 allow"
        if [[ -n "${INTERFACE:-}" ]]; then
            echo "interface: ${INTERFACE}.1"
            echo "access-control: ${INTERFACE}.0/24 allow"
            echo "ip-freebind: yes"
        fi
    } > /run/unbound/listen.conf
    chmod 755 /run/unbound
    chmod 644 /run/unbound/listen.conf
}

# Keys, confs, pngs and saved parameters are secret. Older images created some
# of them group/world-readable (awg_params among them). Templates are left
# alone: check_template has to see the mode the host gave them.
harden_permissions () {
    local dir
    shopt -s nullglob
    for dir in /config/server /config/wg_confs /config/peer* /config/removed_peers /config/removed_peers/*; do
        [[ -d "${dir}" ]] || continue
        chmod 700 "${dir}" 2>/dev/null
        find "${dir}" -maxdepth 1 -type f -exec chmod 600 {} + 2>/dev/null
    done
    shopt -u nullglob
    [[ -f "${STATE_FILE}" ]] && chmod 600 "${STATE_FILE}"
}

# ============================================================================
# Main
# ============================================================================

if [[ -n "$PEERS" ]]; then
    echo "**** Server mode is selected ****"
    GENERATION_BLOCKED=""
    load_state
    ORIG_INTERFACE=${ORIG[INTERFACE]:-}

    if [[ "$PEERS" =~ ^[0-9]+$ ]] && ! [[ "$PEERS" = *,* ]]; then
        mapfile -t PEERS_ARRAY < <(seq 1 "${PEERS}")
    else
        mapfile -t PEERS_ARRAY < <(echo "${PEERS}" | tr ',' '\n')
    fi
    PEER_IDS=()
    PEER_LABELS=()
    declare -A SEEN_PEERS=()
    for i in "${PEERS_ARRAY[@]}"; do
        if [[ ! "${i}" =~ ^[[:alnum:]]+$ ]]; then
            echo "**** Peer ${i} contains non-alphanumeric characters and thus will be skipped. No config for peer ${i} will be generated. ****"
            continue
        fi
        if [[ "${i}" =~ ^[0-9]+$ ]]; then
            PEER_ID="peer${i}"
        else
            PEER_ID="peer_${i}"
        fi
        if [[ -n "${SEEN_PEERS[${PEER_ID}]:-}" ]]; then
            echo "**** ERROR: peer ${i} is listed more than once in PEERS ****"
            GENERATION_BLOCKED=1
            continue
        fi
        SEEN_PEERS[${PEER_ID}]=1
        PEER_IDS+=("${PEER_ID}")
        PEER_LABELS+=("${i}")
    done
    if [[ ${#PEER_IDS[@]} -gt 253 ]]; then
        echo "**** ERROR: Too many peers (${#PEER_IDS[@]}). Maximum is 253 for a /24 subnet ****"
        GENERATION_BLOCKED=1
    fi
    if [[ -n "${PERSISTENTKEEPALIVE_PEERS}" ]]; then
        echo "**** PersistentKeepalive will be set for: ${PERSISTENTKEEPALIVE_PEERS/,/ } ****"
        mapfile -t PERSISTENTKEEPALIVE_PEERS_ARRAY < <(echo "${PERSISTENTKEEPALIVE_PEERS}" | tr ',' '\n')
    fi

    if [[ -z "$SERVERURL" ]] || [[ "$SERVERURL" = "auto" ]]; then
        if SERVERURL=$(detect_public_ipv4); then
            echo "**** SERVERURL var is either not set or is set to \"auto\", setting external IP to auto detected value of $SERVERURL ****"
        elif [[ -n "${ORIG[SERVERURL]:-}" ]] && valid_endpoint_host "${ORIG[SERVERURL]}"; then
            SERVERURL=${ORIG[SERVERURL]}
            echo "**** WARNING: could not detect the external IP, keeping the previous value ${SERVERURL} ****"
        else
            SERVERURL=""
            echo "**** ERROR: could not detect the external IP. Set SERVERURL to this server's public address or DNS name. ****"
            GENERATION_BLOCKED=1
        fi
    else
        # A bare IPv6 address is not a valid Endpoint host; bracket it.
        if [[ "$SERVERURL" == *:* ]] && [[ "$SERVERURL" != \[* ]]; then
            SERVERURL="[${SERVERURL}]"
        fi
        echo "**** External server address is set to $SERVERURL ****"
    fi
    if [[ -n "$SERVERURL" ]] && ! valid_endpoint_host "$SERVERURL"; then
        echo "**** ERROR: SERVERURL \"${SERVERURL}\" is not a valid host name or IP address ****"
        GENERATION_BLOCKED=1
    fi
    SERVERPORT=${SERVERPORT:-51820}
    if [[ ! "$SERVERPORT" =~ ^[0-9]+$ ]] || (( SERVERPORT < 1 || SERVERPORT > 65535 )); then
        echo "**** ERROR: SERVERPORT \"${SERVERPORT}\" is not a port number (1-65535) ****"
        GENERATION_BLOCKED=1
    fi
    echo "**** External server port is set to ${SERVERPORT}. Make sure that port is properly forwarded to port 51820 inside this container ****"
    INTERNAL_SUBNET=${INTERNAL_SUBNET:-10.13.13.0}
    # The subnet is always a /24; older images accepted "10.13.13.0/24" too.
    if [[ "$INTERNAL_SUBNET" == */* ]]; then
        [[ "${INTERNAL_SUBNET#*/}" == 24 ]] || echo "**** WARNING: INTERNAL_SUBNET ${INTERNAL_SUBNET}: only /24 is supported, using ${INTERNAL_SUBNET%%/*}/24 ****"
        INTERNAL_SUBNET=${INTERNAL_SUBNET%%/*}
    fi
    echo "**** Internal subnet is set to $INTERNAL_SUBNET ****"
    if ! is_ipv4 "$INTERNAL_SUBNET"; then
        echo "**** ERROR: INTERNAL_SUBNET \"${INTERNAL_SUBNET}\" is not an IPv4 address such as 10.13.13.0 ****"
        GENERATION_BLOCKED=1
    fi
    INTERFACE=$(echo "$INTERNAL_SUBNET" | awk 'BEGIN{FS=OFS="."} NF--')
    ALLOWEDIPS=${ALLOWEDIPS:-0.0.0.0/0, ::/0}
    echo "**** AllowedIPs for peers $ALLOWEDIPS ****"
    if [[ -z "$PEERDNS" ]] || [[ "$PEERDNS" = "auto" ]]; then
        PEERDNS="${INTERFACE}.1"
        echo "**** PEERDNS var is either not set or is set to \"auto\", setting peer DNS to ${INTERFACE}.1 to use the container's unbound resolver. ****"
        if [[ "${USE_DNS,,}" == "false" ]]; then
            echo "**** WARNING: USE_DNS=false turns unbound off, so peers on PEERDNS=auto will get no DNS. Set PEERDNS to a resolver such as 1.1.1.1. ****"
        fi
        PEERDNS_AUTO=1
    else
        echo "**** Peer DNS servers will be set to $PEERDNS ****"
    fi

    # Load saved AWG params as fallback, then generate/validate
    load_awg_params
    generate_awg_params
    check_awg31_kernel_support

    # shellcheck disable=SC2034 # read through STATE_VARS
    SERVER_ALLOWEDIPS_ALL=$(server_allowedips_all)
    # shellcheck disable=SC2034
    TEMPLATES_HASH=$(cat /config/templates/server.conf /config/templates/peer.conf | sha256sum | cut -d' ' -f1)

    if [[ -n "${GENERATION_BLOCKED}" ]] || [[ -n "${AWG_PARAMS_INVALID}" ]]; then
        config_generation_failed
    elif [[ ! -f /config/wg_confs/wg0.conf ]]; then
        echo "**** No wg0.conf found (maybe an initial install), generating 1 server and ${#PEER_IDS[@]} peer/client confs ****"
        if generate_confs; then
            save_awg_params
            save_vars
        else
            config_generation_failed
        fi
    elif state_changed; then
        echo "**** Server related settings changed (${CHANGED_VAR} and possibly others), regenerating 1 server and ${#PEER_IDS[@]} peer/client confs ****"
        if generate_confs; then
            save_awg_params
            save_vars
        else
            config_generation_failed
        fi
    else
        echo "**** No changes to parameters. Existing configs are used. ****"
        # Nothing changed, so recording the current values is safe; it also
        # fills in keys an older state file lacks, which would otherwise never
        # be compared (see STATE_VARS_OPTIONAL).
        save_awg_params
        save_vars
    fi
else
    echo "**** Client mode selected. ****"
    USE_DNS="${USE_DNS,,}"
    printf %s "${USE_DNS:-false}" > /run/s6/container_environment/USE_DNS
fi

# set up unbound
if [[ ! -f /config/unbound/unbound.conf ]]; then
    cp /defaults/unbound.conf /config/unbound/unbound.conf
fi

if [[ ! -f /config/unbound/root.key ]]; then
    cp /usr/share/dnssec-root/trusted-key.key /config/unbound/root.key
fi

write_unbound_listen
if ! grep -q '/run/unbound/listen.conf' /config/unbound/unbound.conf; then
    if [[ -n "$PEERS" ]] || [[ "${USE_DNS,,}" == "true" ]]; then
        echo "**** NOTE: /config/unbound/unbound.conf predates the generated listen and access-control settings, so unbound keeps listening where that file says. Compare it with /defaults/unbound.conf, or delete it to get the current default on the next start. ****"
    fi
    if [[ -n "${PEERDNS_AUTO:-}" ]]; then
        warn_if_subnet_outside_dns_acl "${INTERFACE}"
    fi
fi

# let openresolv take control of resolv.conf
resolvconf -a control 2>/dev/null < /etc/resolv.conf
resolvconf -u

# permissions
harden_permissions
lsiown -R abc:abc \
    /config

echo "**** Config initialization finished ****"
