#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Probe for the amneziawg kernel module. awg-quick brings tunnels up with
# `ip link add ... type amneziawg`, so the amneziawg module (rtnl link kind
# "amneziawg", not "wireguard") is the only kernel datapath this image can
# use — a plain wireguard module does not help. If it is absent we fall back
# to userspace amneziawg-go (awg-quick does the same fallback on its own).
# amneziawg-go is always in the image (the smoke test checks it), so there is
# no third case.
#
# The probe interface gets a name nothing else uses (<= 15 chars), and an
# existing interface of that name is never touched.
main() {
    local probe
    mkdir -p /config/templates

    echo "Uname info: $(uname -a)"
    probe="awgprobe$$"
    while ip link show dev "${probe}" >/dev/null 2>&1; do
        probe="awgprobe${RANDOM}"
    done
    if ip link add dev "${probe}" type amneziawg 2>/dev/null; then
        ip link del dev "${probe}"
        echo "**** AmneziaWG kernel module is active ****"
        if grep -q "cap_sys_module" <<<"$(capsh --current | grep "Current:")"; then
            echo "**** As the amneziawg module is already active you can remove the SYS_MODULE capability from your container run/compose. ****"
            echo "****     If your host does not automatically load the iptables module, you may still need the SYS_MODULE capability.     ****"
        fi
    else
        echo "**** No amneziawg kernel module available, using userspace amneziawg-go ****"
        # /run/s6/container_environment is what with-contenv reads in s6-overlay v3.
        printf "amneziawg-go" > /run/s6/container_environment/WG_QUICK_USERSPACE_IMPLEMENTATION
    fi
}

# Sourced (unit tests): define the functions only.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
