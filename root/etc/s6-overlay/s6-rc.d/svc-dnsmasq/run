#!/usr/bin/with-contenv bash
# shellcheck shell=bash

CONF=/run/dnsmasq/dnsmasq.conf

# Tells awgctl health what to expect: "invalid" (no usable config, which is
# unhealthy) or "running".
set_state() {
    printf '%s\n' "$1" > /run/dnsmasq-state
}

main() {
    local i
    # Start once svc-amneziawg has brought wg0 up (or failed its first attempt):
    # started earlier, dnsmasq races awg-quick and can miss the tunnel address.
    # Not an s6 dependency, because dnsmasq must still run when the tunnel fails.
    for (( i = 0; i < 300; i++ )); do
        [[ -e /run/amneziawg-settled ]] && break
        sleep 0.2
    done
    [[ -e /run/amneziawg-settled ]] \
        || echo "**** svc-amneziawg has not finished its first attempt after 60s, starting dnsmasq anyway ****"

    # Do not exec dnsmasq with a config it rejects: s6 would restart it in a
    # loop and hide the reason. The tunnel still runs, but the container is
    # unhealthy until the config is fixed.
    if [[ ! -f "${CONF}" ]] || ! dnsmasq --test -C "${CONF}"; then
        set_state invalid
        echo "**** No valid dnsmasq config, dnsmasq will not be started. See the errors above and: awgctl get dns.upstream ****"
        exec sleep infinity
    fi

    set_state running
    exec dnsmasq -k -C "${CONF}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
