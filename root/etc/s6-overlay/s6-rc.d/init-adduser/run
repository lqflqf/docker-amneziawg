#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# A PUID/PGID that cannot be applied stops the container instead of exiting 1:
# a failed oneshot alone leaves an idle container that the restart policy
# never retries.
fatal() {
    echo "**** ERROR: $* ****"
    echo "**** The container is stopping. Fix PUID/PGID and start it again. ****"
    echo 1 > /run/s6-linux-init-container-results/exitcode
    /run/s6/basedir/bin/halt
    exit 1
}

# Sets ID_OUT (no command substitution: fatal must stop this script).
# 0 is refused on purpose: abc owns /config on the host and must not be root.
# usermod would also fail on it, because PID 1 runs as root.
parse_id() {
    local name=$1 value=$2 flag=u
    [[ "${name}" == PGID ]] && flag=g
    if [[ ! "${value}" =~ ^[0-9]{1,10}$ ]] || (( 10#${value} > 4294967294 )); then
        fatal "${name}='${value}' is not a numeric ID between 1 and 4294967294"
    fi
    if (( 10#${value} == 0 )); then
        fatal "${name}=${value} (root) is not supported. Set ${name} to the owner of the /config volume, for example the output of 'id -${flag}'"
    fi
    ID_OUT=$((10#${value}))
}

# One row of the box that branding opens: 44 columns between "│  " and "  │".
# The value must be ASCII (${#} counts bytes in the C locale); a long one is cut.
banner_line() {
    local text ellipsis="" pad=42
    text=$(printf '%-8s %s' "$1" "$2")
    if (( ${#text} > pad )); then
        text=${text:0:pad-1}
        ellipsis="…"
        pad=$((pad - 1))
    fi
    printf '│  ▸ %s%s%*s  │\n' "${text}" "${ellipsis}" $((pad - ${#text})) ''
}

main() {
    local puid pgid build_version build_date
    parse_id PUID "${PUID:-911}"
    puid=${ID_OUT}
    parse_id PGID "${PGID:-911}"
    pgid=${ID_OUT}

    # -o: the ID may belong to another account already (e.g. 100 = users).
    if [[ "$(id -g abc)" != "${pgid}" ]]; then
        groupmod -o -g "${pgid}" abc || fatal "could not set the abc group to PGID ${pgid}"
    fi
    if [[ "$(id -u abc)" != "${puid}" ]]; then
        # Point the home away from /config while changing the UID: usermod
        # re-owns everything under the home directory.
        if ! { usermod -d /root abc && usermod -o -u "${puid}" abc && usermod -d /config abc; }; then
            fatal "could not set the abc user to PUID ${puid}"
        fi
    fi
    [[ "$(id -u abc):$(id -g abc)" == "${puid}:${pgid}" ]] ||
        fatal "abc is $(id -u abc):$(id -g abc), expected PUID:PGID ${puid}:${pgid}"

    echo
    echo
    cat /etc/s6-overlay/s6-rc.d/init-adduser/branding
    banner_line uid:gid "${puid}:${pgid}"
    # The bundled component versions stay in /build_version, out of the log.
    if [[ -f /build_version ]]; then
        build_version=$(sed -n 's/^AmneziaWG version: *//p' /build_version)
        build_date=$(sed -n 's/^Build-date: *//p' /build_version)
        [[ -n "${build_version}" ]] && banner_line version "${build_version}"
        [[ -n "${build_date}" ]] && banner_line built "${build_date}"
    fi
    printf '│%48s│\n╰%s╯\n\n\n' '' '────────────────────────────────────────────────'
}

# Sourced (unit tests): define the functions only.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
