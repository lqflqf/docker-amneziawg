#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Brings up wg0 from the conf that awgctl init rendered. awgctl commands only
# change the database, so nothing else changes wg0 or its conf.

ATTEMPTS=3
RETRY_DELAY=5
CONF=/run/amneziawg/wg0.conf

# svc-dnsmasq waits for this marker, so that dnsmasq starts after wg0. It is
# written after the first attempt, also on failure, so DNS never waits for the
# retries. The finish script removes it.
tunnel_settled() {
    : > /run/amneziawg-settled
}

main() {
    local attempt
    if [[ ! -f "${CONF}" ]]; then
        echo "**** No ${CONF}: awgctl init did not finish ****"
        tunnel_settled
        exit 1
    fi

    for (( attempt = 1; attempt <= ATTEMPTS; attempt++ )); do
        echo "**** Activating tunnel wg0 ****"
        if awg-quick up "${CONF}"; then
            # awg-quick adds the address before "link set up", and dnsmasq's
            # bind-dynamic can miss it. A restart makes dnsmasq bind it.
            if pgrep -x dnsmasq >/dev/null; then
                s6-svc -r /run/service/svc-dnsmasq 2>/dev/null || :
            fi
            tunnel_settled
            echo "**** Tunnel wg0 is up ****"
            exit 0
        fi
        echo "**** Tunnel wg0 failed (attempt ${attempt} of ${ATTEMPTS}) ****"
        awg-quick down "${CONF}" 2>/dev/null || :
        tunnel_settled
        if (( attempt < ATTEMPTS )); then
            sleep "${RETRY_DELAY}"
        fi
    done

    echo "**** Tunnel wg0 is down. Fix the error above and restart the container. ****"
    exit 1
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
