#!/usr/bin/with-contenv bash
# shellcheck shell=bash

main() {
    # A restarted dnsmasq waits for the next svc-amneziawg run, not for this one.
    rm -f /run/amneziawg-settled
    if awg show wg0 >/dev/null 2>&1; then
        echo "**** Disabling tunnel wg0 ****"
        flock /run/awgctl.lock awg-quick down /run/amneziawg/wg0.conf || :
        echo "**** Tunnel wg0 is down ****"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
